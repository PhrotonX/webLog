# Ignore Laravel-related files
/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/vendor
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
testroutes.php

# Ignore filesystem-based user data
/res/img/data
/public/data

# Ignore SQL Backups
public/sql/backups/

# Ignore "hidden" folder
/hidden

# Ignore Laravel Mix output files
public/js/
public/css/
public/mix-manifest.json
